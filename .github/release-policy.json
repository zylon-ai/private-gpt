{
  "schema": 1,
  "trunk": "main",
  "adoption-version": "1.0.1",
  "config": "release-please-config.json",
  "maintenance-config": "release-please-maintenance.json",
  "manifest": ".release-please-manifest.json",
  "workflow": ".github/workflows/release-please.yml",
  "bootstrap-files": [
    ".github/workflows/release-please.yml",
    ".github/workflows/forward-port.yml",
    ".github/workflows/release-policy-check.yml",
    ".github/scripts/release_policy.py",
    ".github/release-policy.json",
    ".github/scripts/test_release_policy.py",
    ".github/workflows/post-release-please.yml",
    ".github/workflows/release-hooks.yml",
    ".github/scripts/image-tag-policy.cjs",
    ".github/scripts/test_image_tags.cjs",
    ".github/workflows/image-tag-policy.yml"
  ],
  "metadata": [
    ".github/release_please/.release-please-config.json",
    ".github/release_please/.release-please-manifest.json",
    ".github/release_please/release-please-maintenance.json",
    ".release-please-manifest.json",
    "CHANGELOG.md",
    "release-please-config.json",
    "release-please-maintenance.json",
    "version.txt"
  ],
  "mixed-version-files": [
    "fern/openapi/openapi.json",
    "pyproject.toml",
    "uv.lock"
  ],
  "legacy-configs": [
    ".github/release_please/.release-please-config.json"
  ],
  "legacy-manifests": [
    ".github/release_please/.release-please-manifest.json"
  ],
  "template-repository": "zylon-ai/zylon-base-template",
  "image-workflows": [
    ".github/workflows/generate-release.yml"
  ]
}
